<Window x:Class="VoidJournal.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VoidJournal" Title="Void Journal" Width="1100" Height="760" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="AppMenu">
      <MenuItem Header="_Journal">
        <MenuItem Header="_Let Everything Go" InputGestureText="Ctrl+Enter" Click="ReleaseClick"/>
        <Separator/>
        <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="SettingsClick"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="ExitClick"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Void" InputGestureText="Ctrl+1" Click="VoidClick"/>
        <MenuItem Header="_Dissolve" InputGestureText="Ctrl+2" Click="DissolveClick"/>
        <Separator/>
        <MenuItem Header="_Bigger" InputGestureText="Ctrl++" Click="BiggerClick"/>
        <MenuItem Header="_Smaller" InputGestureText="Ctrl+-" Click="SmallerClick"/>
        <MenuItem Header="_Default Size" InputGestureText="Ctrl+0" Click="DefaultSizeClick"/>
        <Separator/>
        <MenuItem Header="_Full Screen" InputGestureText="F11" Click="FullScreenClick"/>
      </MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="Show _Introduction" Click="IntroClick"/></MenuItem>
    </Menu>
    <Grid x:Name="WritingArea" ClipToBounds="True">
      <local:JournalSurface x:Name="Surface"/>
      <Canvas>
        <TextBox x:Name="Input" Width="320" Height="55" Background="Transparent" Foreground="Transparent" CaretBrush="Transparent" BorderThickness="0" Padding="0" AcceptsReturn="True" AcceptsTab="False" IsUndoEnabled="False" SpellCheck.IsEnabled="False" ContextMenu="{x:Null}" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Journal writing area" AutomationProperties.HelpText="Write forward only. Backspace edits recent text. Control Enter lets everything go. Nothing is saved.">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </Canvas>
      <Border x:Name="IntroCard" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Padding="24" CornerRadius="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" MaxWidth="500">
        <StackPanel>
          <TextBlock Text="Write it down. Let it go." FontSize="24" Margin="0,0,0,12"/>
          <TextBlock Text="Your newest thought stays. Older words disappear as you write. Nothing is saved. Try full screen for a little more space." TextWrapping="Wrap" Margin="0,0,0,16"/>
          <ComboBox x:Name="IntroTheme" SelectedIndex="0" Margin="0,0,0,16" AutomationProperties.Name="Theme"><ComboBoxItem Content="Void"/><ComboBoxItem Content="Dissolve"/></ComboBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Start writing" Click="StartClick" Margin="0,0,12,0" Padding="16,8"/>
            <Button Content="Enter full screen" Click="StartFullScreenClick" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
